# nginx rasmiy image'i bu shablonni /etc/nginx/conf.d/default.conf ga aylantiradi.
# ${NGINX_LOCAL_RESOLVERS} — konteynerning DNS serveri (/etc/resolv.conf dan avtomatik olinadi)

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # "gateway" manzili har 10 soniyada qayta aniqlanadi: gateway konteyneri qayta yaratilib
    # IP si o'zgarsa ham so'rovlar yangi konteynerga boradi
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $gateway_upstream http://gateway:3000;

    # Old kamera rasmi (8 MB gacha)
    client_max_body_size 20m;

    # API so'rovlari gateway konteyneriga
    location /api/ {
        proxy_pass $gateway_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Vite build fayllari (nomida hash bor) — uzoq keshlanadi
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA: noma'lum yo'llar index.html ga; index.html keshlanmaydi
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
