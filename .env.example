# StudentControl v2:  cp .env.example .env  va 4 ta qatorni to'ldiring

# v2 uchun ALOHIDA bot tokeni (@BotFather). v1 tokeni bo'lmaydi
BOT_TOKEN=

# Loglarni ko'radigan developer(lar) Telegram ID si (botga /id yozib bilasiz), vergul bilan
DEVELOPER_IDS=

# Admin sayt manzili va kaliti. Ikkalasi bo'sh bo'lsa — sinov rejimi (mock)
ADMIN_API_URL=
ADMIN_API_KEY=

# Qolgan sozlamalar ixtiyoriy (standart qiymatlari README da):
# ADMIN_LINK_ID=student_id_number     # yoki id (HEMIS ichki ID)
# ADMIN_API_SEND_HEMIS_PHOTO=false
# WEBAPP_URL=                         # doimiy domen bo'lsa
# JWT_SECRET=                         # production: openssl rand -hex 32
# TG_OFFICIAL_APPS=                   # ruxsat etilgan Telegram ilovalari (paket nomlari, vergul bilan)
# TG_CLIENT_STRICT=false              # true: Android da ilova nomi kelmasa ham bloklash
# FACE_MODE=block                     # yuz tekshiruvi: block (qayta suratga olish) | log (faqat logga) | off
# FACE_THRESHOLD=0.363                # yuz o'xshashligi chegarasi (pastroq — yumshoqroq)
